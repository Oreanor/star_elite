{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && (!data.hasChild('t') || data.child('t').val() < now - 300000)))",
        ".validate": "newData.hasChildren(['name', 'systemIndex', 't'])"
      }
    },
    "poses": {
      ".read": "auth != null",
      "$sys": {
        "$uid": {
          ".write": "auth != null && (auth.uid === $uid || (!newData.exists() && (!data.hasChild('t') || data.child('t').val() < now - 300000)))",
          ".validate": "newData.hasChildren(['x', 'y', 'z', 't'])"
        }
      }
    },
    "portals": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['galaxySeed', 'fromSystem', 'toSystem', 'radius', 'from', 'to', 'traveler', 't', 'expiresAt'])"
      }
    },
    "systemPortals": {
      ".read": "auth != null",
      "$sys": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['galaxySeed', 'fromSystem', 'toSystem', 'radius', 'from', 'to', 'traveler', 't', 'expiresAt'])"
        }
      }
    },
    "chats": {
      "$cid": {
        ".read": "auth != null && $cid.contains(auth.uid)",
        ".write": "auth != null && $cid.contains(auth.uid)",
        "messages": {
          "$mid": {
            ".validate": "newData.hasChildren(['from', 'text']) && newData.child('from').val() === auth.uid"
          }
        }
      }
    },
    "inbox": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$from": {
          ".write": "auth != null && ($from === auth.uid || auth.uid === $uid)",
          ".validate": "auth.uid === $uid || newData.hasChildren(['name'])"
        }
      }
    },
    "hits": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$hid": {
          ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || auth.uid === $uid)",
          ".validate": "newData.hasChildren(['dmg', 'from']) && newData.child('dmg').isNumber() && newData.child('from').val() === auth.uid"
        }
      }
    },
    "traffic": {
      ".read": "auth != null",
      "$key": {
        "host": {
          ".write": "auth != null && (!data.exists() || data.child('uid').val() === auth.uid || data.child('t').val() < now - 4500)",
          ".validate": "!newData.exists() || (newData.hasChildren(['uid', 't']) && newData.child('uid').val() === auth.uid)"
        },
        "hits": {
          "$owner": {
            "$hid": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || auth.uid === $owner)",
              ".validate": "!newData.exists() || (newData.hasChildren(['hid', 'dmg', 'from']) && newData.child('dmg').isNumber() && newData.child('from').val() === auth.uid)"
            }
          }
        },
        "pods": {
          "$pid": {
            ".write": "auth != null && (!data.exists() ? newData.child('by').val() === auth.uid : (!newData.exists() || (!data.hasChild('taken') && newData.child('taken').val() === auth.uid)))",
            ".validate": "!newData.exists() || newData.hasChildren(['i', 'p', 'v', 't', 'by'])"
          }
        },
        "own": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "rocks": {
          "$rid": {
            ".write": "auth != null",
            ".validate": "!newData.exists() || newData.hasChildren(['p', 'v', 't', 'r', 'sh'])"
          }
        },
        "rockhits": {
          "$hid": {
            ".write": "auth != null && (!data.exists() ? newData.child('from').val() === auth.uid : !newData.exists())",
            ".validate": "!newData.exists() || (newData.hasChildren(['rid', 'dmg', 'from']) && newData.child('dmg').isNumber())"
          }
        },
        "bases": {
          ".write": "auth != null && root.child('traffic').child($key).child('host').child('uid').val() === auth.uid"
        },
        "plats": {
          "$pid": {
            ".write": "auth != null && ($pid.beginsWith(auth.uid + ':') || root.child('traffic').child($key).child('host').child('uid').val() === auth.uid)"
          }
        },
        "structhits": {
          "$owner": {
            "$hid": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === $owner && !newData.exists()))",
              ".validate": "!newData.exists() || newData.hasChildren(['kind', 'from'])"
            }
          }
        },
        "here": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "claim": {
          "$owner": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === $owner && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['hid', 'from']) && newData.child('hid').isNumber())"
            }
          }
        },
        "grant": {
          "$to": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && newData.child('from').val() === auth.uid) || (auth.uid === $to && !newData.exists()))",
              ".validate": "!newData.exists() || (newData.hasChildren(['hid', 'from']) && newData.child('hid').isNumber())"
            }
          }
        },
        "titans": {
          ".write": "auth != null && root.child('traffic').child($key).child('host').child('uid').val() === auth.uid"
        }
      }
    },
    "god": {
      ".read": "auth != null",
      "$seed": {
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "!newData.exists() || newData.hasChildren(['name', 'rel', 'at'])"
        }
      }
    }
  }
}
